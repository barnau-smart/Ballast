# Ballast backend environment variables.
# Copy to `.env` for local overrides. Never commit a real .env with secrets.

# Postgres connection string (psycopg v3 / postgresql:// scheme).
# The async SQLAlchemy layer (FastAPI-Users) derives the postgresql+asyncpg://
# form from this same value automatically — set only this one URL.
DATABASE_URL=postgresql://ballast:ballast@localhost:5432/ballast

# Comma-separated list of CORS origins allowed by the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Secret used by FastAPI-Users' UserManager to sign registration/reset tokens.
# This dev default is safe for local only — set a real, random secret via env
# in any non-local environment. NEVER commit a real secret.
USER_MANAGER_SECRET=dev-only-insecure-user-manager-secret-change-me

# --- Brokerage / Story 2.1 ---------------------------------------------------

# Fernet key that encrypts brokerage OAuth tokens at the application layer.
# The key lives HERE in the environment, NEVER in the database.
# This dev default is PUBLIC and therefore INSECURE — it only exists so the
# fake link flow runs locally. Generate a real, secret key for any non-local
# environment with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NEVER commit a real key.
TOKEN_ENCRYPTION_KEY=SU5TRUNVUkUtZGV2LWtleS1kby1ub3QtdXNlISEhAAA=

# Which broker adapter to use: "fake" (default, no credentials, local/dev/test)
# or "schwab" (real, requires the three SCHWAB_* values below).
BROKER_ADAPTER=fake

# Schwab developer-app credentials. Leave empty to keep the Schwab adapter
# gated; the fake adapter needs none of these. When your Schwab app is
# approved, fill these in and set BROKER_ADAPTER=schwab.
SCHWAB_CLIENT_ID=v0m2FnU6jKVnGqbmZwluSeWgvSgxGxvBiJHIGVgl12L5qAub
SCHWAB_CLIENT_SECRET=DzVmfyHY2fgrovI2VO5stYWq0IYEXUBs6ooKu5KX3vc5wQfdJ4LGXMQjEfkZWO7p
SCHWAB_CALLBACK_URL=https://127.0.0.1:7080/api/schwab/callback

# --- Market data / Story 3.1 -------------------------------------------------

# Which market-data adapter to use: "fake" (default, deterministic, no creds,
# no network — the tested path) or "tiingo" (real EOD source, requires
# TIINGO_API_KEY below). Swapping is a config change only (AD-8).
MARKETDATA_ADAPTER=fake

# Tiingo API key. Leave empty to keep the Tiingo adapter gated; the fake adapter
# needs none. When you have a key, set it here and MARKETDATA_ADAPTER=tiingo.
TIINGO_API_KEY=

# --- LLM / Story 4.1 ---------------------------------------------------------

# Which LLM gateway adapter to use: "fake" (default, deterministic, no creds,
# no network — the tested path) or "anthropic" (real Claude calls, requires
# ANTHROPIC_API_KEY below). Swapping is a config change only (AD-6).
LLM_ADAPTER=fake

# Anthropic API key. Leave empty to keep the Anthropic gateway gated; the fake
# adapter needs none. When you have a key, set it here and LLM_ADAPTER=anthropic.
# The key is never logged.
ANTHROPIC_API_KEY=
